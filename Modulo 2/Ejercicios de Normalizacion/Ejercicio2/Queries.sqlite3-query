-- SQLite
CREATE TABLE company (
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL,
    policies VARCHAR(25) NOT NULL
);

CREATE TABLE owner (
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL,
    phone INT NOT NULL
);

CREATE TABLE make(
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL
);

CREATE TABLE color(
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL
);

CREATE TABLE model(
    id INT PRIMARY KEY,
    makeid INT REFERENCES make(id),
    colorid INT REFERENCES color(id),
    name VARCHAR(25) NOT NULL,
    years INT NOT NULL
);

CREATE TABLE car(
    id INT PRIMARY KEY,
    modelid INT REFERENCES model(id),
    vin VARCHAR(25)
);

CREATE TABLE car_owner(
    id INT PRIMARY KEY,
    ownerid INT REFERENCES owner(id),
    carid INT REFERENCES car(id)
);

CREATE TABLE company_owner(
    id INT PRIMARY KEY,
    ownerid INT REFERENCES owner(id),
    companyid INT REFERENCES company(id)
);

