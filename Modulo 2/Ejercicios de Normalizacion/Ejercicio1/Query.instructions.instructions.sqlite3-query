-- SQLite
CREATE TABLE costumer (
    id INT PRIMARY KEY,
    phone_number INT NOT NULL,
    name VARCHAR(25) NOT NULL
);

CREATE TABLE address(
    id INT PRIMARY KEY,
    costumerid INT REFERENCES costumer(id),
    adressname VARCHAR(25)
);

CREATE TABLE item (
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL,
    price INT NOT NULL
);

CREATE TABLE recipe(
    id INT PRIMARY KEY,
    costumerid INT REFERENCES costumer(id),
    addressid INT REFERENCES address(id),
    deliveryTime VARCHAR(25) NOT NULL
);


CREATE TABLE recipe_item (
    repiceid VARCHAR(25) REFERENCES recipe(id),
    itemid INT REFERENCES item,
    amount INT NOT NULL,
    specialRequest VARCHAR(25)
);


