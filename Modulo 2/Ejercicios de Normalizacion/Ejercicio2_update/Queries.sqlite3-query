-- SQLite
CREATE TABLE company (
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL
);

CREATE TABLE owners(
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL,
    phone VARCHAR (25) NOT NULL
);

CREATE TABLE make(
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL
);

CREATE TABLE color(
    id INT PRIMARY KEY,
    name VARCHAR(25) NOT NULL
);

CREATE TABLE model(
    id INT PRIMARY KEY,
    makeid INT REFERENCES make(id),
    colorid INT REFERENCES color(id),
    name VARCHAR(25) NOT NULL,
    years INT NOT NULL
);

CREATE TABLE insurance_policy(
    id INT PRIMARY KEY,
    companyid INT REFERENCES company(id),
    policy_code VARCHAR(25) 
);

CREATE TABLE car(
    id INT PRIMARY KEY,
    vin VARCHAR(25),
    modelid INT REFERENCES model(id)
);

CREATE TABLE car_info(
    id INT PRIMARY KEY, 
    carid INT REFERENCES car(id),
    ownerid INT REFERENCES owners(id),
    insurance_policy_id INT REFERENCES insurance_policy(id)
);

